{
  "manifest_version": 3,
  "name": "DawnWire Product Importer & Social Auto-Post",
  "version": "4.0.0",
  "description": "Import products from Amazon, Walmart, Best Buy, AliExpress, eBay into DawnWire. Auto-pin to Pinterest & post to Facebook/Instagram.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://dawnwire.com/*",
    "https://www.dawnwire.com/*",
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.ca/*",
    "https://www.amazon.com.au/*",
    "https://www.amazon.de/*",
    "https://www.amazon.fr/*",
    "https://www.amazon.it/*",
    "https://www.amazon.es/*",
    "https://www.amazon.in/*",
    "https://www.amazon.co.jp/*",
    "https://www.amazon.com.mx/*",
    "https://www.amazon.nl/*",
    "https://www.amazon.sg/*",
    "https://www.amazon.ae/*",
    "https://www.amazon.sa/*",
    "https://www.amazon.se/*",
    "https://www.amazon.pl/*",
    "https://www.amazon.com.tr/*",
    "https://www.amazon.br/*",
    "https://www.amazon.com.be/*",
    "https://www.amazon.eg/*",
    "https://www.walmart.com/*",
    "https://www.bestbuy.com/*",
    "https://www.aliexpress.com/*",
    "https://www.ebay.com/*",
    "https://www.ebay.co.uk/*",
    "https://www.ebay.de/*",
    "https://www.ebay.fr/*",
    "https://www.ebay.it/*",
    "https://www.ebay.es/*",
    "https://www.ebay.com.au/*"
  ],
  "action": {
    "default_popup": "social-media-popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://dawnwire.com/*",
        "https://www.dawnwire.com/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.de/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.in/*",
        "https://www.amazon.co.jp/*",
        "https://www.amazon.com.mx/*",
        "https://www.amazon.nl/*",
        "https://www.amazon.sg/*",
        "https://www.amazon.ae/*",
        "https://www.amazon.sa/*",
        "https://www.amazon.se/*",
        "https://www.amazon.pl/*",
        "https://www.amazon.com.tr/*",
        "https://www.amazon.br/*",
        "https://www.amazon.com.be/*",
        "https://www.amazon.eg/*",
        "https://www.walmart.com/*",
        "https://www.bestbuy.com/*",
        "https://www.aliexpress.com/*",
        "https://www.ebay.com/*",
        "https://www.ebay.co.uk/*",
        "https://www.ebay.de/*",
        "https://www.ebay.fr/*",
        "https://www.ebay.it/*",
        "https://www.ebay.es/*",
        "https://www.ebay.com.au/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "social-background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
