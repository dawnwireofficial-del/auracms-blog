# ====== SUPABASE (Required) ======
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ====== AUTHENTICATION ======
# ADMIN_EMAIL is the email that gets super_admin role on first Supabase login
ADMIN_EMAIL=admin@dawnwire.com
JWT_SECRET=your-random-64-char-secret

# ====== AMAZON PRODUCT ADVERTISING API (Required for price/availability sync) ======
AMAZON_ACCESS_KEY=AKIAXXXXXXXXXXXXXXXX
AMAZON_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AMAZON_PARTNER_TAG=dawnwire-20

# ====== AI Gateway (powers all AI features) ======
# Get a free API key from https://dashboard.cohere.com/api-keys
AI_GATEWAY_API_KEY=your-cohere-api-key
# Optional: custom base URL if using a proxy/gateway
# AI_GATEWAY_BASE_URL=https://api.cohere.ai/v2
# Model to use (default: command-r-plus-08-2024)
# AI_GATEWAY_MODEL=command-r-plus-08-2024

# ====== Legacy AI (Optional - fallback only) ======
COHERE_API_KEY=your-cohere-api-key
GEMINI_API_KEY=your-gemini-api-key
API_KEY=fallback-api-key

# ====== Gemini (FREE primary provider) ======
# Get a free key from https://aistudio.google.com (free tier ~1000 requests/day).
# Tried FIRST for all AI features; DeepSeek/Cohere are fallbacks. Empty = disabled.
GEMINI_API_KEY=your-gemini-api-key
# Optional model override (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# ====== DeepSeek (Optional - multi-key rotation + auto-failover) ======
# Comma-separated list of DeepSeek API keys from https://platform.deepseek.com.
# Keys are tried round-robin; on 429/5xx the pool rotates to the next key and
# temporarily cools down the failing key. Cohere is used as fallback when all
# keys fail or when this is empty.
DEEPSEEK_API_KEYS=sk-xxx,sk-yyy,sk-zzz
# Optional overrides (defaults shown)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ====== IMGBB (Optional - banner/profile image storage) ======
# Get a free key from https://api.imgbb.com. Used by the admin
# /upload-image endpoint for banners and profile images. Imported
# product images keep their original Amazon CDN URLs (served via
# the image proxy), so this is NOT used for product imports.
IMGBB_API_KEY=your-imgbb-api-key

# ====== EMAIL (Optional - for newsletter/welcome emails) ======
RESEND_API_KEY=re_xxxxxxxxxxxx

# ====== KNOCK NOTIFICATIONS (Optional - price-drop/deal alerts + in-app bell) ======
# Provisioned automatically by the "Knock" integration on Vercel (settings > integrations).
# KNOCK_API_KEY (secret, server-side) + KNOCK_PUBLIC_API_KEY (safe for the browser).
# The in-app notification bell appears in the header once KNOCK_PUBLIC_API_KEY is set.
# Create a workflow named "price-drop" (recipients -> in-app feed channel "default",
# optional email channel) and one named "deal-alert" for wishlist users. Override
# the workflow keys with these if you name them differently:
# KNOCK_PRICE_DROP_WORKFLOW=price-drop
# KNOCK_DEAL_WORKFLOW=deal-alert
# KNOCK_SIGNING_KEY=whsec_xxxxxxxx  # optional: enables secure real-time feed auth

# ====== SITE CONFIG ======
APP_URL=https://www.dawnwire.com
ALLOWED_ORIGINS=https://www.dawnwire.com,http://localhost:3000
PORT=3000
NODE_ENV=production
