
# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, sitemaps, and API endpoints.
APP_URL="http://localhost:3000"

# PORT: The port the Express server listens on (default: 3000)
PORT="3000"

# NODE_ENV: Environment mode (development | production)
NODE_ENV="development"

# SUPABASE_URL: Your Supabase project URL (e.g. https://xxxxx.supabase.co)
# Required to use Supabase PostgreSQL backend instead of local JSON file.
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Your Supabase anon/public key
SUPABASE_ANON_KEY=""

# SUPABASE_DB_URL: Your Supabase direct PostgreSQL connection string
# e.g. postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
# Used by the server for all CRUD operations (bypasses RLS).
SUPABASE_DB_URL=""

# SUPABASE_SERVICE_KEY: Supabase service_role key for admin-level operations
# Only needed if using Supabase with elevated privileges.
SUPABASE_SERVICE_KEY=""

# RESEND_API_KEY: Required for transactional emails (welcome, contact, comment notifications, newsletter)
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Sender email address for outgoing emails
# Must be a verified domain in Resend
RESEND_FROM_EMAIL="noreply@auracms.blog"

# ADMIN_EMAIL: Where contact form inquiries are forwarded
ADMIN_EMAIL="admin@aura.com"

# COHERE_API_KEY: API key for Cohere AI (used for AI article generation)
COHERE_API_KEY=""

# COHERE_MODEL: Cohere model to use for AI content generation
# Options: command-r-plus-08-2024, command-r-08-2024, command-light
COHERE_MODEL="command-r-plus-08-2024"

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins
# Defaults to APP_URL if not set
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# DISABLE_HMR: Set to "true" to disable Vite Hot Module Replacement
DISABLE_HMR="false"
