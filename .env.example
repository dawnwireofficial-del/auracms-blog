# ====== SUPABASE (Required) ======
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ====== AUTHENTICATION ======
# ADMIN_EMAIL is the email that gets super_admin role on first Supabase login
ADMIN_EMAIL=admin@dawnwire.com
JWT_SECRET=your-random-64-char-secret

# ====== AMAZON PRODUCT ADVERTISING API (Required for price/availability sync) ======
AMAZON_ACCESS_KEY=AKIAXXXXXXXXXXXXXXXX
AMAZON_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AMAZON_PARTNER_TAG=dawnwire-20

# ====== AI (Optional - falls back gracefully) ======
COHERE_API_KEY=your-cohere-api-key
GEMINI_API_KEY=your-gemini-api-key
API_KEY=fallback-api-key

# ====== EMAIL (Optional - for newsletter/welcome emails) ======
RESEND_API_KEY=re_xxxxxxxxxxxx

# ====== SITE CONFIG ======
APP_URL=https://www.dawnwire.com
ALLOWED_ORIGINS=https://www.dawnwire.com,http://localhost:3000
PORT=3000
NODE_ENV=production
