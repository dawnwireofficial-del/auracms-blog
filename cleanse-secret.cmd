@powershell -NoProfile -Command "$c=Get-Content 'check_supabase.mjs' -Raw -ErrorAction SilentlyContinue; if ($c) { $c=$c -replace '''sbp_[a-f0-9_]+''','process.env.SUPABASE_ACCESS_TOKEN'; Set-Content -NoNewline 'check_supabase.mjs' -Value $c }; $c=Get-Content 'migrate_rest.mjs' -Raw -ErrorAction SilentlyContinue; if ($c) { $c=$c -replace '''sbp_[a-f0-9_]+''','process.env.SUPABASE_ACCESS_TOKEN'; Set-Content -NoNewline 'migrate_rest.mjs' -Value $c }"
